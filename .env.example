# Copy to .env and fill in. .env is ignored by git; never commit real values.

# Required. At least 32 bytes; the API refuses to start without it.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

POSTGRES_DB=matcha
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Outside docker compose use localhost instead of the "database" host.
DATABASE_URL=postgresql://postgres:change-me@database:5432/matcha

# Email (verification and password reset), from https://mailtrap.io
MAILTRAP_API_KEY=
MAILTRAP_FROM_EMAIL=noreply@matcha.com
MAILTRAP_FROM_NAME=Matcha

# 42 OAuth (optional)
FT_CLIENT_ID=
FT_CLIENT_SECRET=
